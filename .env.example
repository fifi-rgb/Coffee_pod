# Email address where Gmail deal alerts should be delivered.
GMAIL_TO=you@example.com
# Timezone used by n8n.
GENERIC_TIMEZONE=Europe/London
# System timezone used by the container.
TZ=Europe/London
# Encryption key for n8n credentials; generate with `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=replace-me
# Needed so n8n expressions can read $env.GMAIL_TO.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
